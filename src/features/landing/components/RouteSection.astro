---
import SectionHeading from "./SectionHeading.astro"
import { ROUTE } from "../data/content"
import type { LandingStats } from "../lib/stats"

interface Props {
  stats: LandingStats
}

const { stats } = Astro.props
const { route } = stats

const outputs = route
  ? [
      {
        from: "categoría",
        href: route.category.href,
        value: route.category.href,
        note: `el listado de ${route.category.label}`
      },
      {
        from: "archivo",
        href: route.url,
        value: route.url,
        note: route.file.title
      }
    ]
  : []
---

<section
  class="wall-shell wall-section"
  aria-labelledby="la-ruta"
>
  <SectionHeading
    id="la-ruta"
    title={ROUTE.title}
    lead={ROUTE.lead}
  />

  <div class="wall-route">
    {
      route && (
        <>
          <div
            class="wall-path"
            role="img"
            aria-label={`Ruta de ejemplo: ${route.root}${route.category.segment}${route.subcategory.segment}${route.file.segment}`}
          >
            <span class="wall-path__segment wall-path__segment--root">
              <i>raíz</i>
              <b>{route.root}</b>
            </span>
            <span class="wall-path__segment">
              <i>categoría</i>
              <b>{route.category.segment}</b>
            </span>
            <span class="wall-path__segment">
              <i>subcategoría</i>
              <b>{route.subcategory.segment}</b>
            </span>
            <span class="wall-path__segment wall-path__segment--file">
              <i>entrada</i>
              <b>{route.file.segment}</b>
            </span>
          </div>

          <p class="wall-micro wall-route__outputs-title">
            {ROUTE.outputsTitle}
          </p>

          <ul class="wall-outputs">
            {outputs.map((output) => (
              <li>
                <a
                  href={output.href}
                  class="wall-output__link"
                >
                  <span class="wall-output__from">{output.from}</span>
                  <span class="wall-output__value">{output.value}</span>
                  <span class="wall-output__note">{output.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="wall-route__note">{ROUTE.note}</p>
  </div>
</section>
