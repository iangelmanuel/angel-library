---
import { CATALOG } from "../data/content"
import type { LandingStats } from "../lib/stats"

interface Props {
  stats: LandingStats
}

const { stats } = Astro.props
const listed = stats.categoryList
---

<section
  class="wall-shell wall-catalog"
  aria-labelledby="el-indice"
>
  <div class="wall-catalog__head">
    <h2 id="el-indice">{CATALOG.title}</h2>
    <span
      class="wall-catalog__rule"
      aria-hidden="true"
    ></span>
    <span class="wall-catalog__count">{stats.categories} categorías</span>
  </div>

  <p class="wall-cloud">
    {
      listed.map((category, index) => (
        <>
          <span class="wall-cloud__word">{category.label}</span>
          {index < listed.length - 1 && (
            <span
              class="wall-cloud__dot"
              aria-hidden="true"
            >
              ·
            </span>
          )}
        </>
      ))
    }
  </p>
</section>
