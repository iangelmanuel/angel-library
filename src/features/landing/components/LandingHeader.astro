---
import Icon from "@/components/shared/Icon.astro"
import Logo from "@/components/shared/Logo.astro"
import SearchButton from "@/components/shared/SearchButton.astro"
import ThemeToggle from "@/components/shared/ThemeToggle.astro"
import { SITE_NAV, SOCIAL_LINKS } from "@/config/navigation"
---

<header class="chrome-header">
  <div class="chrome-header__inner">
    <Logo />

    <nav
      class="chrome-header__nav"
      aria-label="Secciones de la biblioteca"
    >
      {
        SITE_NAV.map((item) => (
          <a
            href={item.href}
            class:list={{ "is-current": item.href === "/" }}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="chrome-header__right">
      <SearchButton />

      <ThemeToggle />

      <div class="chrome-header__social">
        {
          SOCIAL_LINKS.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
            >
              <Icon
                name={item.icon}
                size={16}
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>
