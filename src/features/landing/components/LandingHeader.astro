---
import Icon from "@/components/shared/Icon.astro"
import Logo from "@/components/shared/Logo.astro"
import { SITE } from "@/config/site"

// La misma cabecera que la documentación.

const NAV = [
  { label: "Inicio", href: "/" },
  { label: "Categorías", href: "/categories" },
  { label: "Tipos", href: "/tipos/guides" },
  { label: "Tags", href: "/tags" }
]

const SOCIAL = [
  { label: "GitHub", icon: "brand-github", href: SITE.social.github },
  { label: "X", icon: "brand-x", href: SITE.social.x }
]
---

<header class="chrome-header">
  <div class="chrome-header__inner">
    <Logo />

    <nav
      class="chrome-header__nav"
      aria-label="Secciones de la biblioteca"
    >
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={{ "is-current": item.href === "/" }}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="chrome-header__right">
      <a
        href="/buscar"
        class="chrome-header__search chrome-search"
        aria-label="Abrir la búsqueda"
      >
        <Icon
          name="search"
          class="size-4"
        />
        <span class="chrome-search__text">Buscar</span>
        <kbd class="kbd">ctrl K</kbd>
      </a>

      <div class="chrome-header__social">
        {
          SOCIAL.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
            >
              <Icon
                name={item.icon}
                class="size-4"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>
