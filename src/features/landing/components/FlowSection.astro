---
import SectionHeading from "./SectionHeading.astro"
import { FLOW } from "../data/content"
---

<section
  class="wall-shell wall-section"
  aria-labelledby="recorrido"
>
  <SectionHeading
    id="recorrido"
    title={FLOW.title}
  />

  <ol class="wall-legs">
    {
      FLOW.legs.map((leg, index) => (
        <li class="wall-leg">
          <span
            class="wall-leg__index"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, "0")}
          </span>
          <div class="wall-leg__body">
            <h3 class="wall-leg__title">{leg.title}</h3>
            <p class="wall-leg__line">{leg.line}</p>
          </div>
          <p class="wall-leg__detail">{leg.detail}</p>
        </li>
      ))
    }
  </ol>
</section>
