---
import Search from "@astrojs/starlight/components/Search.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import type { JsonLdBlock, SeoProps } from "@/lib/seo"
import LandingHeader from "../components/LandingHeader.astro"
import LandingFooter from "../components/LandingFooter.astro"

import "../styles/landing.css"

interface Props extends SeoProps {
  jsonLd?: readonly JsonLdBlock[]
}

const { title, description, ...seoProps } = Astro.props
---

<BaseLayout
  {...seoProps}
  title={title}
  description={description}
>
  <div class="flex min-h-svh flex-col">
    <LandingHeader />

    <main
      id="contenido"
      class="flex-1"
    >
      <slot />
    </main>

    <LandingFooter />

    {
      /* El modal de Pagefind: lo abren la cabecera y el hero, no un botón suyo. */
    }
    <Search class="landing-search" />
  </div>
</BaseLayout>

<script>
  // Un único buscador en la portada: la cabecera y el campo del hero abren el
  // mismo modal de Pagefind.
  document.addEventListener("click", (event) => {
    const disparador = (event.target as HTMLElement).closest(
      "[data-open-search]"
    )
    if (!disparador) return

    // En diferido: el modal se cierra solo si se abre mientras este mismo
    // clic sigue propagándose, porque para él es un clic fuera del diálogo.
    requestAnimationFrame(() => {
      document
        .querySelector<HTMLButtonElement>(
          ".landing-search button[data-open-modal]"
        )
        ?.click()
    })
  })
</script>
