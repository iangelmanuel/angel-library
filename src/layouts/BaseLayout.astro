---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"
import { TerminalDialog } from "@/features/terminal"
import BaseHead from "@/components/seo/BaseHead.astro"
import JsonLd from "@/components/seo/JsonLd.astro"
import { SITE } from "@/config/site"
import {
  organizationLd,
  webSiteLd,
  type JsonLdBlock,
  type SeoProps
} from "@/lib/seo"

interface Props extends SeoProps {
  jsonLd?: readonly JsonLdBlock[]
}

const { jsonLd = [], ...seoProps } = Astro.props
---

<!doctype html>
<html
  lang={SITE.seo.lang}
  class="dark"
>
  <head>
    <BaseHead {...seoProps} />
    <JsonLd
      id="ld-organization"
      data={organizationLd()}
    />
    <JsonLd
      id="ld-website"
      data={webSiteLd()}
    />
    {
      jsonLd.map((block) => (
        <JsonLd
          id={block.id}
          data={block.data}
        />
      ))
    }
    <ClientRouter />
  </head>
  <body>
    <a
      href="#contenido"
      class="skip-link"
      >Saltar al contenido</a
    >

    <slot />

    <TerminalDialog
      client:only="react"
      transition:persist="command-palette"
    />

    <script>
      import "@/scripts/site-interactions"
    </script>
  </body>
</html>
