---
import Analytics from "@vercel/analytics/astro"

import BaseHead from "@/components/seo/BaseHead.astro"
import JsonLd from "@/components/seo/JsonLd.astro"

import {
  organizationLd,
  webSiteLd,
  type JsonLdBlock,
  type SeoProps
} from "@/lib/seo"
import { SITE } from "@/config/site"

import "@/styles/global.css"

interface Props extends SeoProps {
  jsonLd?: readonly JsonLdBlock[]
}

const { jsonLd = [], ...seoProps } = Astro.props
---

<!doctype html>
<html lang={SITE.seo.lang}>
  <head>
    <script is:inline>
      const stored = localStorage.getItem("starlight-theme")
      document.documentElement.dataset.theme =
        stored === "light" || stored === "dark"
          ? stored
          : matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark"
    </script>

    <BaseHead {...seoProps} />
    <JsonLd
      id="ld-organization"
      data={organizationLd()}
    />
    <JsonLd
      id="ld-website"
      data={webSiteLd()}
    />
    {
      jsonLd.map((block) => (
        <JsonLd
          id={block.id}
          data={block.data}
        />
      ))
    }
    <Analytics />
  </head>
  <body>
    <a
      href="#contenido"
      class="skip-link"
      >Saltar al contenido</a
    >

    <slot />
  </body>
</html>
