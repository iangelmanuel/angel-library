---
import BaseLayout from "./BaseLayout.astro"
import Header from "@/components/layout/Header.astro"
import Sidebar from "@/components/layout/Sidebar.astro"
import MobileNav from "@/components/layout/MobileNav"
import { getAllEntries } from "@/lib/content"
import { buildNavData } from "@/lib/nav"

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props

const allEntries = await getAllEntries()
const navData = buildNavData(allEntries)
---

<BaseLayout
  title={title}
  description={description}
>
  <div class="flex min-h-svh flex-col">
    <Header />

    <div class="mx-auto flex w-full max-w-[1440px] flex-1 items-start">
      <Sidebar data={navData} />

      <main
        id="contenido"
        class="min-w-0 flex-1 px-4 py-8 sm:px-6 lg:px-10"
      >
        <slot />
      </main>

      <slot name="aside" />
    </div>

    <footer class="border-t border-border">
      <div
        class="mx-auto flex w-full max-w-[1440px] flex-wrap items-center justify-between gap-2 px-4 py-6 font-mono text-[0.68rem] text-muted-foreground/70"
      >
        <span>angel.library</span>
        <span>contenido propio · estático · astro</span>
      </div>
    </footer>
  </div>

  <MobileNav
    client:load
    data={navData}
  />
</BaseLayout>
