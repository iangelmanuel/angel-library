---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import { getAllEntries } from "@/lib/content"

const entries = await getAllEntries()
---

<StarlightPage
  frontmatter={{
    title: "Buscar",
    description: `Busca en las ${entries.length} entradas de la biblioteca.`,
    template: "splash",
    tableOfContents: false
  }}
>
  <p>
    Pulsa <kbd>Ctrl</kbd> + <kbd>K</kbd> o usa el buscador de la cabecera.
  </p>
</StarlightPage>

<script>
  function openSearch() {
    const button = document.querySelector<HTMLButtonElement>(
      "site-search button[data-open-modal]"
    )
    button?.click()
  }

  // Abre el buscador tanto en la primera carga como tras una transición.
  document.addEventListener("DOMContentLoaded", openSearch, { once: true })
  document.addEventListener("astro:page-load", openSearch)
</script>
