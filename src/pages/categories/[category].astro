---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro"
import ContentCard from "@/components/content/ContentCard.astro"
import Icon from "@/components/shared/Icon.astro"
import { CATEGORY_LIST, type CategoryMeta } from "@/config/categories"
import { getAllEntries, getCategorySections } from "@/lib/content"

export function getStaticPaths() {
  return CATEGORY_LIST.map((meta) => ({
    params: { category: meta.id },
    props: { meta }
  }))
}

interface Props {
  meta: CategoryMeta
}

const { meta } = Astro.props
const { entries, sections } = getCategorySections(
  await getAllEntries(),
  meta.id
)
---

<DocsLayout
  title={meta.label}
  description={meta.description}
>
  <div class:list={["mx-auto w-full max-w-4xl", `category-${meta.id}`]}>
    <Breadcrumbs
      items={[
        { label: "inicio", href: "/" },
        { label: meta.label.toLowerCase(), segment: meta.id }
      ]}
    />

    <header class="mb-8 border-b border-border pb-8">
      <h1
        class="flex items-center gap-3 font-display text-2xl md:text-3xl"
        style={`--cat-accent: var(${meta.color})`}
      >
        <Icon
          name={meta.icon}
          class="size-6 shrink-0 text-[var(--cat-accent)]"
        />
        {meta.label}
        <span
          class="font-mono text-base font-normal text-muted-foreground"
          data-numeric
        >
          {entries.length}
        </span>
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        {meta.description}
      </p>
    </header>

    {
      entries.length > 0 ? (
        sections.map((section) => (
          <section
            class="mb-10"
            aria-label={section.label}
          >
            <h2
              class:list={[
                "section-label mb-4",
                section.icon && "flex items-center gap-2"
              ]}
            >
              {section.icon && (
                <Icon
                  name={section.icon}
                  class="size-3.5"
                />
              )}
              {section.label}
            </h2>
            {section.description && (
              <p class="-mt-2 mb-4 max-w-2xl text-sm text-muted-foreground">
                {section.description}
              </p>
            )}
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {section.entries.map((entry) => (
                <ContentCard entry={entry} />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="empty-field">aún no hay contenido en esta categoría</p>
      )
    }
  </div>
</DocsLayout>
