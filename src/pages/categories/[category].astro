---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import EntryList from "@/components/content/EntryList.astro"
import { CATEGORIES, CATEGORY_IDS } from "@/config/categories"
import { getAllEntries, getCategoryEntries } from "@/lib/content"

export async function getStaticPaths() {
  const all = await getAllEntries()

  return CATEGORY_IDS.map((category) => {
    const { groups, ungrouped } = getCategoryEntries(all, category)
    return { params: { category }, props: { groups, ungrouped, category } }
  })
}

const { category, groups, ungrouped } = Astro.props
const meta = CATEGORIES[category]
---

<StarlightPage
  frontmatter={{ title: meta.label, description: meta.description }}
>
  {
    groups.map((group) => (
      <section>
        <h2 id={group.id}>{group.label}</h2>
        {group.description && <p>{group.description}</p>}
        <EntryList entries={group.entries} />
      </section>
    ))
  }

  {
    ungrouped.length > 0 && (
      <section>
        <h2 id="sueltas">Sin subcategoría</h2>
        <EntryList entries={ungrouped} />
      </section>
    )
  }
</StarlightPage>
