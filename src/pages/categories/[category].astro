---
import DocsLayout from '@/layouts/DocsLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ContentCard from '@/components/content/ContentCard.astro';
import Icon from '@/components/shared/Icon.astro';
import {
  CATEGORY_LIST,
  RESOURCE_CATEGORIES,
  STACK_GROUPED_CATEGORIES,
  getStacksForCategory,
  type CategoryMeta,
} from '@/config/site';
import { getAllEntries, sortByLearningPath } from '@/lib/content';

export function getStaticPaths() {
  return CATEGORY_LIST.map((meta) => ({
    params: { category: meta.id },
    props: { meta },
  }));
}

interface Props {
  meta: CategoryMeta;
}

const { meta } = Astro.props;
const entries = (await getAllEntries()).filter((entry) => entry.data.category === meta.id);
const orderedEntries = sortByLearningPath(entries);
const resourceGroups = meta.id === 'resources'
  ? Object.entries(RESOURCE_CATEGORIES)
      .map(([id, label]) => ({
        id,
        label,
        entries: entries.filter(
          (entry) => entry.collection === 'resources' && entry.data.resourceCategory === id,
        ),
      }))
      .filter((group) => group.entries.length > 0)
  : [];
const resourceIntroEntries = meta.id === 'resources'
  ? sortByLearningPath(entries.filter((entry) => entry.collection !== 'resources'))
  : [];
const usesStackGroups = STACK_GROUPED_CATEGORIES.includes(meta.id);
const stackGroups = usesStackGroups
  ? getStacksForCategory(meta.id).map((stack) => ({
      id: stack.id,
      label: stack.label,
      entries: sortByLearningPath(entries.filter((entry) => entry.data.stack === stack.id)),
    })).filter((group) => group.entries.length > 0)
  : [];
const ungroupedStack = usesStackGroups
  ? sortByLearningPath(entries.filter((entry) => !entry.data.stack))
  : [];
---

<DocsLayout title={meta.label} description={meta.description}>
  <div class:list={['mx-auto w-full max-w-4xl', `category-${meta.id}`]}>
    <Breadcrumbs
      items={[{ label: 'inicio', href: '/' }, { label: meta.label.toLowerCase(), segment: meta.id }]}
    />

    <header class="mb-8 border-b border-border pb-8">
      <div class="mb-4 flex items-center gap-2 text-muted-foreground">
        <Icon name={meta.icon} class="size-4" />
        <span class="font-pixel text-[0.62rem] uppercase tracking-wider">
          {entries.length} entrada{entries.length === 1 ? '' : 's'}
        </span>
      </div>
      <h1 class="font-pixel text-2xl md:text-3xl">{meta.label}</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{meta.description}</p>
    </header>

    {
      entries.length > 0 ? (
        meta.id === 'resources' ? (
          <>
            {resourceIntroEntries.length > 0 && (
              <section class="mb-10">
                <h2 class="section-label mb-4 flex items-center gap-2">
                  <Icon name="book-open" class="size-3.5" />
                  Guías y fundamentos
                </h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {resourceIntroEntries.map((entry) => <ContentCard entry={entry} />)}
                </div>
              </section>
            )}
            {resourceGroups.map((group) => (
              <section class="mb-10">
                <h2 class="section-label mb-4 flex items-center gap-2">
                  <Icon name="bookmark" class="size-3.5" />
                  {group.label}
                </h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {group.entries.map((entry) => <ContentCard entry={entry} />)}
                </div>
              </section>
            ))}
          </>
        ) : usesStackGroups ? (
          <>
            {stackGroups.map((group) => (
              <section class="mb-10">
                {/* Subcategoría sin icono propio: los iconos van en cada entrada (tecnología, dependencia o componente) */}
                <h2 class="section-label mb-4">{group.label}</h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {group.entries.map((entry) => <ContentCard entry={entry} />)}
                </div>
              </section>
            ))}
            {ungroupedStack.length > 0 && (
              <section class="mb-10">
                <h2 class="section-label mb-4 flex items-center gap-2">
                  <Icon name="book-open" class="size-3.5" />
                  Fundamentos y referencias
                </h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {ungroupedStack.map((entry) => <ContentCard entry={entry} />)}
                </div>
              </section>
            )}
          </>
        ) : (
          <section class="mb-10" aria-label={`Documentación de ${meta.label}`}>
            <h2 class="section-label mb-4">Ruta de aprendizaje</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {orderedEntries.map((entry) => <ContentCard entry={entry} />)}
            </div>
          </section>
        )
      ) : (
        <p class="border border-dashed border-border px-4 py-10 text-center font-mono text-xs text-muted-foreground">
          aún no hay contenido en esta categoría
        </p>
      )
    }
  </div>
</DocsLayout>
