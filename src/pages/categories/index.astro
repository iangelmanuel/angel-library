---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import { getAllEntries, getCategoryCounts } from "@/lib/content"

const categories = getCategoryCounts(await getAllEntries()).sort(
  (a, b) => b.count - a.count
)
---

<StarlightPage
  frontmatter={{
    title: "Categorías",
    description: "Las 23 categorías de la biblioteca y lo que guarda cada una."
  }}
>
  <ul class="category-grid not-content">
    {
      categories.map((category) => (
        <li>
          <a
            href={`/categories/${category.id}`}
            style={`--card-accent: var(${category.color})`}
          >
            <span class="category-grid__label">{category.label}</span>
            <span class="category-grid__count">{category.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</StarlightPage>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .category-grid a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.4rem;
    border-radius: var(--radius-field);
    background: color-mix(in oklab, var(--card-accent) 18%, #000000);
    padding: 0.75rem 0.9rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-enamel);
  }
  .category-grid a:hover {
    background: color-mix(in oklab, var(--card-accent) 30%, #000000);
  }
  .category-grid__label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--white);
  }
  .category-grid__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--gray-300);
  }
</style>
