---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro"
import Icon from "@/components/shared/Icon.astro"
import { getAllEntries, getCategoryCounts } from "@/lib/content"

/** El muro completo: una pieza de esmalte por categoría. El peso de cada
    categoría se lee en cuántas celdas ocupa, no en el tamaño de su letra. */

const categories = getCategoryCounts(await getAllEntries()).sort(
  (a, b) => b.count - a.count
)
const total = categories.reduce((sum, category) => sum + category.count, 0)
const largest = categories[0]?.count ?? 1

/** Tres pesos: la categoría más grande ocupa el doble de ancho que la menor. */
function weightOf(count: number): "lg" | "md" | "sm" {
  const share = count / largest
  if (share >= 0.55) return "lg"
  if (share >= 0.25) return "md"
  return "sm"
}
---

<DocsLayout
  title="Categorías"
  description="Todas las categorías de la biblioteca, con el número de entradas que guarda cada una."
>
  <div class="mx-auto w-full max-w-5xl">
    <Breadcrumbs items={[{ label: "Categorías" }]} />

    <header class="mb-8 border-b border-border pb-8">
      <h1 class="font-display text-2xl md:text-3xl">
        Categorías
        <span
          class="ml-2 align-middle font-mono text-base font-normal text-muted-foreground"
          data-numeric
        >
          {categories.length}
        </span>
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        La carpeta decide la categoría. Cada campo lleva el esmalte con el que
        esa categoría aparece en el resto del sitio, y ocupa el sitio que le da
        su contenido: {total} entradas en total.
      </p>
    </header>

    <div class="wall">
      {
        categories.map((category) => (
          <a
            href={`/categories/${category.id}`}
            class:list={["wall-tile", `wall-tile--${weightOf(category.count)}`]}
            style={`--card-accent: var(${category.color})`}
          >
            <Icon
              name={category.icon}
              class="wall-tile__icon size-4"
            />
            <span class="wall-tile__label">{category.label}</span>
            <span
              class="wall-tile__count"
              data-numeric
            >
              {category.count}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</DocsLayout>
