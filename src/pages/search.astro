---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro"
import { Terminal } from "@/features/terminal"
---

<DocsLayout
  title="Buscar"
  description="Búsqueda global en toda la biblioteca: tecnologías, librerías, snippets, recetas, comandos y más."
>
  <div class="mx-auto w-full max-w-4xl">
    <Breadcrumbs
      items={[
        { label: "inicio", href: "/" },
        { label: "buscar", segment: "search" }
      ]}
    />

    <header class="mb-8 border-b border-border pb-8">
      <h1 class="font-pixel text-2xl md:text-3xl">Buscar</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        Escribe directamente para consultar documentos, comienza con <code
          >#</code
        > para explorar tags o utiliza <code>/</code> para ejecutar comandos. Prueba
        <code>/help</code> para conocer los disponibles. La salida se desplaza dentro
        de la consola sin mover la página.
      </p>
    </header>

    <Terminal client:load />

    <noscript>
      <p class="callout">
        La búsqueda necesita JavaScript. También puedes navegar por categorías y
        tags desde la barra lateral.
      </p>
    </noscript>
  </div>
</DocsLayout>
