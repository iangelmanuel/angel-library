---
import DocsLayout from '@/layouts/DocsLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import SearchResults from '@/components/search/SearchResults';
---

<DocsLayout
  title="Buscar"
  description="Búsqueda global en toda la biblioteca: tecnologías, librerías, snippets, recetas, comandos y más."
>
  <div class="mx-auto w-full max-w-3xl">
    <Breadcrumbs items={[{ label: 'inicio', href: '/' }, { label: 'buscar' }]} />

    <header class="mb-8 border-b border-border pb-8">
      <h1 class="font-pixel text-2xl md:text-3xl">Buscar</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        Busca por título, tag, descripción o contenido. Desde cualquier página puedes
        abrir el command palette con <kbd class="kbd">ctrl K</kbd> o <kbd class="kbd">/</kbd>.
      </p>
    </header>

    <SearchResults client:load />

    <noscript>
      <p class="callout">
        La búsqueda necesita JavaScript. También puedes navegar por categorías y tipos
        desde la barra lateral.
      </p>
    </noscript>
  </div>
</DocsLayout>
