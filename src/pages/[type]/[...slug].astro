---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Toc from '@/components/layout/Toc.astro';
import ReadingProgress from '@/components/layout/ReadingProgress.astro';
import PageNav from '@/components/layout/PageNav.astro';
import TypeBadge from '@/components/content/TypeBadge.astro';
import TagList from '@/components/content/TagList.astro';
import EntryMeta from '@/components/content/EntryMeta.astro';
import RelationSection from '@/components/content/RelationSection.astro';
import Icon from '@/components/shared/Icon.astro';
import {
  CATEGORIES,
  CONTENT_TYPES,
  type CategoryId,
  type ContentTypeId,
} from '@/config/site';
import {
  buildEntryMap,
  formatDate,
  getAllEntries,
  sortByLearningPath,
} from '@/lib/content';
import { getRelated, validateContentRelations } from '@/lib/relations';

/**
 * Ruta dinámica única para TODAS las entradas de la biblioteca.
 * Añadir un archivo .md a cualquier colección genera su página
 * automáticamente, sin tocar rutas ni componentes.
 */
export async function getStaticPaths() {
  const all = await getAllEntries();
  // Integridad referencial: el build falla aquí si hay ids duplicados
  // o referencias a entradas inexistentes.
  validateContentRelations(all);
  return all.map((entry) => ({
    params: { type: entry.collection, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content, headings } = await render(entry);

const all = await getAllEntries();
const entryMap = buildEntryMap(all);
const related = getRelated(entry, all, entryMap);

const typeMeta = CONTENT_TYPES[entry.collection as ContentTypeId];
const categoryMeta = CATEGORIES[entry.data.category as CategoryId];

const currentStack = (entry.data as { stack?: string }).stack;
const siblings = sortByLearningPath(
  all.filter((item) => {
    if (item.data.category !== entry.data.category) return false;
    return (item.data as { stack?: string }).stack === currentStack;
  }),
);
const index = siblings.findIndex((item) => item.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;

const relatedExplicit = [...related.explicit, ...related.backlinks];

// Detecta bloques de código con nombre de archivo (```ts title="lib/dom.ts")
// en el markdown crudo, para mostrar el botón "copiar código completo"
// solo cuando hay algo real que copiar.
const hasNamedCodeBlocks = /```[^\n]*\btitle=["']/.test(entry.body ?? '');
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <ReadingProgress />
  <Toc slot="aside" headings={headings} />

  <article class:list={['mx-auto w-full max-w-3xl', `knowledge-${entry.collection}`]}>
    <Breadcrumbs
      items={[
        { label: 'inicio', href: '/' },
        { label: typeMeta.label.toLowerCase(), href: `/${typeMeta.id}` },
        { label: entry.data.title },
      ]}
    />

    <header class="mb-8 border-b border-border pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <TypeBadge type={entry.collection as ContentTypeId} linked />
        <a
          href={`/categories/${categoryMeta.id}`}
          class="badge"
          style={`color: var(${categoryMeta.color}); border-color: color-mix(in srgb, var(${categoryMeta.color}) 35%, var(--border))`}
        >
          <Icon name={categoryMeta.icon} class="size-3" />
          {categoryMeta.label}
        </a>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3">
        <h1 class="font-pixel text-2xl leading-snug md:text-3xl">{entry.data.title}</h1>
        {
          hasNamedCodeBlocks && (
            <button
              type="button"
              class="copy-all-btn"
              data-copy-all
              title="Copia todo el código de esta página en un solo bloque, listo para pegar en tu proyecto"
            >
              <Icon name="files" class="size-3.5" />
              <span data-copy-label>Copiar código completo</span>
            </button>
          )
        }
      </div>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        {entry.data.description}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
        <TagList tags={entry.data.tags ?? []} />
        {
          entry.data.updatedAt && (
            <span class="font-mono text-[0.68rem] text-muted-foreground/70">
              actualizado: {formatDate(entry.data.updatedAt)}
            </span>
          )
        }
      </div>
    </header>

    <EntryMeta entry={entry} entryMap={entryMap} />

    <div class="markdown">
      <Content />
    </div>

    <div>
      <RelationSection title="Integraciones" icon="blocks" entries={related.integrations} />
      <RelationSection title="Recetas" icon="list-checks" entries={related.recipes} />
      <RelationSection title="Recursos" icon="link" entries={related.resources} />
      <RelationSection title="Relacionado" icon="corner-down-right" entries={relatedExplicit} />
      <RelationSection title="Contenido similar" icon="tags" entries={related.byTags} />
    </div>

    <PageNav prev={prev} next={next} />
  </article>
</DocsLayout>
