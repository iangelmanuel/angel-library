---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Icon from "@/components/shared/Icon.astro"

const DESTINATIONS = [
  {
    href: "/",
    icon: "house",
    label: "Inicio",
    description: "El índice completo, con las categorías y lo último editado."
  },
  {
    href: "/search",
    icon: "search",
    label: "Buscar",
    description: "Busca en el texto de toda la biblioteca."
  },
  {
    href: "/tags",
    icon: "tags",
    label: "Tags",
    description: "Salta entre temas que cruzan varias categorías."
  }
]
---

<DocsLayout
  title="Página no encontrada"
  description="La ruta solicitada no existe en la biblioteca."
  noindex
>
  <div class="mx-auto w-full max-w-4xl">
    <header class="mb-8 border-b border-border pb-8">
      <h1 class="flex items-center gap-3 font-display text-2xl md:text-3xl">
        <Icon
          name="triangle-alert"
          class="size-6 shrink-0 text-[var(--blue-400)]"
        />
        Esta ruta no existe
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        El documento se movió de carpeta, cambió de nombre o nunca estuvo aquí.
        Las rutas de la biblioteca siguen el patrón <code
          >/categoría/subcategoría/documento</code
        >, así que subir un nivel suele llevar al sitio correcto.
      </p>
    </header>

    <h2 class="section-label mb-4">Volver al camino</h2>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        DESTINATIONS.map((destination) => (
          <a
            href={destination.href}
            class="card destination-card"
          >
            <span class="destination-card__heading">
              <Icon
                name={destination.icon}
                class="size-4"
              />
              <strong>{destination.label}</strong>
            </span>
            <span class="destination-card__description">
              {destination.description}
            </span>
            <span class="destination-card__footer">{destination.href}</span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-muted-foreground">
      Atajo: pulsa <kbd class="kbd">ctrl K</kbd> para abrir el índice desde cualquier
      página.
    </p>
  </div>
</DocsLayout>
