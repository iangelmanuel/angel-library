---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Icon from "@/components/shared/Icon.astro"

const DESTINATIONS = [
  {
    href: "/",
    command: "cd ~",
    icon: "house",
    label: "Inicio",
    description: "El índice completo, con las categorías y lo último editado."
  },
  {
    href: "/search",
    command: "grep -R",
    icon: "search",
    label: "Buscar",
    description: "La consola busca en el texto de toda la biblioteca."
  },
  {
    href: "/tags",
    command: "ls ./tags",
    icon: "tags",
    label: "Tags",
    description: "Salta entre temas que cruzan varias categorías."
  }
]
---

<DocsLayout
  title="Página no encontrada"
  description="La ruta solicitada no existe en la biblioteca."
  noindex
>
  <div class="mx-auto w-full max-w-4xl">
    <header class="mb-8 border-b border-border pb-8">
      <div class="mb-4 flex items-center gap-2 text-muted-foreground">
        <Icon
          name="triangle-alert"
          class="size-4"
        />
        <span class="font-pixel text-[0.62rem] tracking-wider uppercase">
          error 404
        </span>
      </div>
      <h1 class="font-pixel text-2xl md:text-3xl">Esta ruta no existe</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        El documento se movió de carpeta, cambió de nombre o nunca estuvo aquí.
        Las rutas de la biblioteca siguen el patrón <code
          >/categoría/subcategoría/documento</code
        >, así que subir un nivel suele llevar al sitio correcto.
      </p>
    </header>

    <h2 class="section-label mb-4">Volver al camino</h2>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        DESTINATIONS.map((destination) => (
          <a
            href={destination.href}
            class="card category-card"
          >
            <span
              class="category-card__command"
              aria-hidden="true"
            >
              <b>$</b> {destination.command}
            </span>
            <span class="category-card__heading">
              <Icon
                name={destination.icon}
                class="size-4"
              />
              <strong>{destination.label}</strong>
            </span>
            <span class="category-card__description">
              {destination.description}
            </span>
            <span class="category-card__footer">
              <span>{destination.href}</span>
              <span aria-hidden="true">open ↗</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 font-mono text-xs text-muted-foreground">
      Atajo: pulsa <kbd class="kbd">ctrl K</kbd> para abrir la terminal desde cualquier
      página.
    </p>
  </div>
</DocsLayout>
