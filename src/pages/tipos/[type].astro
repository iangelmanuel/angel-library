---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro"
import ContentCard from "@/components/content/ContentCard.astro"
import Icon from "@/components/shared/Icon.astro"
import { CONTENT_TYPE_LIST, type ContentTypeMeta } from "@/config/content-types"
import { getAllEntries, getEntriesByType, sortByTitle } from "@/lib/content"

export function getStaticPaths() {
  return CONTENT_TYPE_LIST.map((meta) => ({
    params: { type: meta.id },
    props: { meta }
  }))
}

interface Props {
  meta: ContentTypeMeta
}

const { meta } = Astro.props
const entries = sortByTitle(getEntriesByType(await getAllEntries(), meta.id))
---

<DocsLayout
  title={meta.label}
  description={meta.description}
>
  <div class:list={["mx-auto w-full max-w-5xl", `type-${meta.id}`]}>
    <Breadcrumbs
      items={[
        { label: "inicio", href: "/" },
        { label: meta.label.toLowerCase(), segment: meta.id }
      ]}
    />

    <header class="mb-8 border-b border-border pb-8">
      <div class="mb-4 flex items-center gap-2 text-muted-foreground">
        <Icon
          name={meta.icon}
          class="size-4"
        />
        <span class="font-pixel text-[0.62rem] tracking-wider uppercase">
          {entries.length} entrada{entries.length === 1 ? "" : "s"}
        </span>
      </div>
      <h1 class="font-pixel text-2xl md:text-3xl">{meta.label}</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        {meta.description}
      </p>
    </header>

    {
      entries.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <ContentCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="border border-dashed border-border px-4 py-10 text-center font-mono text-xs text-muted-foreground">
          aún no hay entradas de este tipo
        </p>
      )
    }
  </div>
</DocsLayout>
