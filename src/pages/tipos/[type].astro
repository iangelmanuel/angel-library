---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import EntryList from "@/components/content/EntryList.astro"
import { CONTENT_TYPES, CONTENT_TYPE_IDS } from "@/config/content-types"
import { getAllEntries, getEntriesByType } from "@/lib/content"

export async function getStaticPaths() {
  const all = await getAllEntries()

  return CONTENT_TYPE_IDS.map((type) => ({
    params: { type },
    props: { entries: getEntriesByType(all, type), type }
  }))
}

const { type, entries } = Astro.props
const meta = CONTENT_TYPES[type]
---

<StarlightPage
  frontmatter={{ title: meta.label, description: meta.description }}
>
  <EntryList entries={entries} />
</StarlightPage>
