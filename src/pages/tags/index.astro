---
import DocsLayout from '@/layouts/DocsLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { getAllEntries, getAllTags } from '@/lib/content';

const tags = getAllTags(await getAllEntries());
---

<DocsLayout
  title="Tags"
  description="Todos los tags de la biblioteca: conectan contenido de cualquier tipo y categoría."
>
  <div class="mx-auto w-full max-w-4xl">
    <Breadcrumbs items={[{ label: 'inicio', href: '/' }, { label: 'tags' }]} />

    <header class="mb-8 border-b border-border pb-8">
      <div class="mb-4 flex items-center gap-2 text-muted-foreground">
        <span class="font-pixel text-[0.62rem] uppercase tracking-wider">
          {tags.length} tags
        </span>
      </div>
      <h1 class="font-pixel text-2xl md:text-3xl">Tags</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
        Los tags conectan contenido de cualquier tipo y categoría. Úsalos para saltar
        entre temas y descubrir contenido relacionado.
      </p>
    </header>

    <div class="flex flex-wrap gap-2">
      {
        tags.map(({ tag, count }) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="badge"
            style="color: var(--accent-purple); border-color: color-mix(in srgb, var(--accent-purple) 35%, var(--border))"
          >
            <span class="font-mono text-[0.7rem] normal-case tracking-normal">
              #{tag}
            </span>
            <span class="font-mono text-[0.6rem] opacity-70">{count}</span>
          </a>
        ))
      }
    </div>
  </div>
</DocsLayout>
