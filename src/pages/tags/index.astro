---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import { getAllEntries, getAllTags } from "@/lib/content"

const tags = getAllTags(await getAllEntries())
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: "Tags",
    description: "Todos los tags de la biblioteca: cruzan cualquier categoría."
  }}
>
  <ul class="tag-cloud not-content">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.tag}`}>
            <span>#{tag.tag}</span>
            <span class="tag-cloud__count">{tag.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</StarlightPage>

<style>
  .tag-cloud {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tag-cloud a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius);
    background: var(--enamel-900);
    padding: 0.6rem 0.7rem;
    font-size: 0.82rem;
    color: var(--blue-300);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-enamel);
  }
  .tag-cloud a:hover {
    background: var(--enamel-700);
    color: var(--white);
  }
  .tag-cloud__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gray-450);
  }
</style>
