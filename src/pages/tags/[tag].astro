---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import EntryList from "@/components/content/EntryList.astro"
import { getAllEntries, getAllTags, getEntriesByTag } from "@/lib/content"

export async function getStaticPaths() {
  const all = await getAllEntries()

  return getAllTags(all).map(({ tag, count }) => ({
    params: { tag },
    props: { entries: getEntriesByTag(all, tag), count }
  }))
}

const { tag } = Astro.params
const { entries, count } = Astro.props
---

<StarlightPage
  frontmatter={{
    title: `#${tag}`,
    description: `${count} entradas etiquetadas con "${tag}".`
  }}
>
  <p><a href="/tags">Ver todos los tags</a></p>
  <EntryList entries={entries} />
</StarlightPage>
