---
import DocsLayout from "@/layouts/DocsLayout.astro"
import ContentCard from "@/components/content/ContentCard.astro"
import Icon from "@/components/shared/Icon.astro"
import { CATEGORY_LIST, CONTENT_TYPE_LIST, SITE } from "@/config/site"
import { getAllEntries, getAllTags } from "@/lib/content"

const all = await getAllEntries()

const typeCards = CONTENT_TYPE_LIST.map((meta) => ({
  ...meta,
  count: all.filter((entry) => entry.collection === meta.id).length
}))

const categories = CATEGORY_LIST.map((meta) => ({
  ...meta,
  count: all.filter((entry) => entry.data.category === meta.id).length
})).filter((category) => category.count > 0)

const recent = [...all]
  .filter((entry) => entry.data.updatedAt)
  .sort((a, b) => b.data.updatedAt!.getTime() - a.data.updatedAt!.getTime())
  .slice(0, 6)

const topTags = getAllTags(all).slice(0, 14)
---

<DocsLayout>
  <div class="mx-auto w-full max-w-4xl">
    <section class="border-b border-border pb-10 pt-2">
      <p class="badge mb-5">
        <Icon
          name="terminal"
          class="size-3"
        />
        segundo cerebro técnico
      </p>
      <h1 class="font-pixel text-3xl leading-tight md:text-4xl">{SITE.name}</h1>
      <p class="mt-4 max-w-xl leading-relaxed text-muted-foreground">
        {SITE.description}
      </p>

      <button
        type="button"
        data-open-search
        class="mt-7 flex w-full max-w-md items-center gap-2 border border-border bg-card px-3 py-2.5 text-left text-sm text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground"
        aria-label="Abrir búsqueda (Control K)"
      >
        <Icon
          name="search"
          class="size-4"
        />
        <span class="flex-1">Buscar en la biblioteca…</span>
        <kbd class="kbd">ctrl</kbd>
        <kbd class="kbd">K</kbd>
      </button>
      <p class="mt-3 font-mono text-[0.68rem] text-muted-foreground/80">
        tip: pulsa <kbd class="kbd">/</kbd> en cualquier página para buscar
      </p>
    </section>

    <section
      class="mt-10"
      aria-label="Tipos de contenido"
    >
      <h2 class="section-label mb-4">Explorar por tipo</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          typeCards.map((type) => (
            <a
              href={`/${type.id}`}
              class="card gap-2 p-3"
            >
              <span class="flex items-center gap-2 text-muted-foreground">
                <Icon
                  name={type.icon}
                  class="size-3.5"
                />
                <span class="font-mono text-[0.65rem]">{type.count}</span>
              </span>
              <span class="font-pixel text-[0.66rem] uppercase tracking-wider text-foreground">
                {type.label}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="mt-10"
      aria-label="Categorías"
    >
      <h2 class="section-label mb-4">Categorías</h2>
      <div class="flex flex-wrap gap-2">
        {
          categories.map((category) => (
            <a
              href={`/categories/${category.id}`}
              class="badge"
            >
              <Icon
                name={category.icon}
                class="size-3"
              />
              {category.label}
              <span class="font-mono text-[0.6rem] opacity-70">
                {category.count}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {
      recent.length > 0 && (
        <section
          class="mt-10"
          aria-label="Contenido reciente"
        >
          <h2 class="section-label mb-4">Actualizado recientemente</h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {recent.map((entry) => (
              <ContentCard entry={entry} />
            ))}
          </div>
        </section>
      )
    }

    <section
      class="mt-10"
      aria-label="Tags"
    >
      <h2 class="section-label mb-4">Tags</h2>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        {
          topTags.map(({ tag, count }) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="tag"
            >
              {tag}
              <span class="ml-1 text-muted-foreground/60">{count}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</DocsLayout>
