---
import {
  LandingLayout,
  HeroWall,
  CatalogSection,
  RouteSection,
  FlowSection,
  CtaSection,
  loadStats
} from "@/features/landing"

const stats = await loadStats()
---

<LandingLayout>
  <HeroWall stats={stats} />
  <CatalogSection stats={stats} />
  <RouteSection stats={stats} />
  <FlowSection />
  <CtaSection />
</LandingLayout>
