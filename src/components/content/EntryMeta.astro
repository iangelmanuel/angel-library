---
import Icon from "@/components/shared/Icon.astro"
import CopyButton from "@/components/shared/CopyButton.astro"
import { CONTENT_TYPES } from "@/config/content-types"
import {
  RESOURCE_CATEGORIES,
  type ResourceCategoryId
} from "@/config/resources"
import { getEntryUrl, type AnyEntry } from "@/lib/content"
import { translateBlock } from "@/markdown/package-manager.mjs"

/** Metadatos propios del tipo, entre la cabecera y el markdown. */

const PACKAGE_MANAGERS = ["pnpm", "bun", "npm"] as const

interface Props {
  entry: AnyEntry
  entryMap: Map<string, AnyEntry>
}

const { entry, entryMap } = Astro.props
const data = entry.data as Record<string, unknown>

const techRefs = Array.isArray(data.technologies) ? data.technologies : []
const techEntries = techRefs
  .map((ref) => (typeof ref === "string" ? entryMap.get(ref) : undefined))
  .filter((item): item is AnyEntry => Boolean(item))

const warnings: string[] = Array.isArray(data.warnings)
  ? (data.warnings as string[])
  : []

const website = typeof data.website === "string" ? data.website : null
const github = typeof data.github === "string" ? data.github : null
const problem =
  (entry.data.type === "recipes" ||
    entry.data.type === "patterns" ||
    entry.data.type === "tricks") &&
  typeof data.problem === "string"
    ? data.problem
    : null
const command =
  entry.data.type === "commands" && typeof data.command === "string"
    ? data.command
    : null
const install =
  entry.data.type === "libraries" && typeof data.install === "string"
    ? data.install
    : null
const installTabs = install !== null ? translateBlock(install) : null
const resourceUrl =
  entry.data.type === "resources" && typeof data.url === "string"
    ? data.url
    : null
const tool =
  entry.data.type === "skills" && typeof data.tool === "string"
    ? data.tool
    : null
const language =
  (entry.data.type === "snippets" ||
    entry.data.type === "hooks" ||
    entry.data.type === "utilities") &&
  typeof data.language === "string"
    ? data.language
    : null

const hasMeta =
  website !== null ||
  github !== null ||
  problem !== null ||
  command !== null ||
  install !== null ||
  resourceUrl !== null ||
  techEntries.length > 0 ||
  tool !== null ||
  language !== null
---

{
  hasMeta && (
    <div class="mb-8 flex flex-col gap-4">
      {(website !== null || github !== null) && (
        <div class="flex flex-wrap items-stretch gap-2">
          {website !== null && (
            <a
              href={website}
              target="_blank"
              rel="noopener noreferrer"
              class="card mt-0 min-w-64 flex-1 flex-row items-center gap-3"
            >
              <span class="grid size-9 shrink-0 place-items-center border border-border bg-muted">
                <Icon
                  name="external-link"
                  class="size-4"
                />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate font-mono text-xs text-muted-foreground">
                  {website}
                </span>
                <span class="font-pixel text-[0.62rem] tracking-wider text-foreground uppercase">
                  documentación oficial
                </span>
              </span>
            </a>
          )}
          {github !== null && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="badge shrink-0 self-start"
            >
              <Icon
                name="brand-github"
                class="size-3"
              />
              GitHub
            </a>
          )}
        </div>
      )}

      {problem !== null && (
        <div class="callout mt-0">
          <span class="font-pixel text-[0.62rem] tracking-wider text-muted-foreground uppercase">
            Problema ·{" "}
          </span>
          {problem}
        </div>
      )}

      {command !== null && (
        <>
          <div class="code-block mt-0">
            <div class="code-block__header">
              <span class="code-block__label">terminal</span>
              <CopyButton label="Copiar comando" />
            </div>
            <pre
              class="command-line"
              set:text={command}
            />
          </div>

          {typeof data.whenToUse === "string" && (
            <p class="text-sm text-muted-foreground">
              <strong class="font-medium text-foreground">
                Cuándo usarlo:
              </strong>{" "}
              {data.whenToUse}
            </p>
          )}

          {warnings.length > 0 && (
            <div class="callout mt-0">
              <p class="mb-1.5 flex items-center gap-2 font-pixel text-[0.62rem] tracking-wider text-muted-foreground uppercase">
                <Icon
                  name="triangle-alert"
                  class="size-3.5"
                />{" "}
                Ojo
              </p>
              <ul class="flex flex-col gap-1">
                {warnings.map((warning) => (
                  <li>{warning}</li>
                ))}
              </ul>
            </div>
          )}
        </>
      )}

      {install !== null && installTabs && (
        <div class="code-block code-block--pm mt-0">
          <div class="code-block__header">
            <div
              class="code-block__pm-tabs"
              role="tablist"
            >
              {PACKAGE_MANAGERS.map((packageManager) => (
                <button
                  type="button"
                  class={
                    packageManager === "pnpm"
                      ? "code-block__pm-tab is-active"
                      : "code-block__pm-tab"
                  }
                  data-pm-tab={packageManager}
                >
                  {packageManager}
                </button>
              ))}
            </div>
            <CopyButton label="Copiar comando de instalación" />
          </div>
          {PACKAGE_MANAGERS.map((packageManager) => (
            <pre
              class="command-line"
              data-pm={packageManager}
              hidden={packageManager !== "pnpm"}
              set:text={installTabs[packageManager]}
            />
          ))}
        </div>
      )}

      {install !== null && !installTabs && (
        <div class="code-block mt-0">
          <div class="code-block__header">
            <span class="code-block__label">instalación</span>
            <CopyButton label="Copiar comando de instalación" />
          </div>
          <pre
            class="command-line"
            set:text={install}
          />
        </div>
      )}

      {resourceUrl !== null && (
        <a
          href={resourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card mt-0 flex-row items-center gap-3"
        >
          <span class="grid size-9 shrink-0 place-items-center border border-border bg-muted">
            <Icon
              name="external-link"
              class="size-4"
            />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-mono text-xs text-muted-foreground">
              {resourceUrl}
            </span>
            <span class="font-pixel text-[0.62rem] tracking-wider text-foreground uppercase">
              abrir recurso
            </span>
          </span>
          {typeof data.resourceCategory === "string" && (
            <span class="badge">
              {RESOURCE_CATEGORIES[data.resourceCategory as ResourceCategoryId]}
            </span>
          )}
        </a>
      )}

      {techEntries.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-pixel text-[0.62rem] tracking-wider text-muted-foreground uppercase">
            {entry.data.type === "integrations" ? "Combina" : "Usa"}
          </span>
          {techEntries.map((tech) => (
            <a
              href={getEntryUrl(tech)}
              class="badge"
            >
              <Icon
                name={CONTENT_TYPES[tech.data.type].icon}
                class="size-3"
              />
              {tech.data.title}
            </a>
          ))}
        </div>
      )}

      {tool !== null && (
        <div>
          <span class="badge">
            <Icon
              name="bot"
              class="size-3"
            />
            {tool}
          </span>
        </div>
      )}

      {language !== null && (
        <div>
          <span class="badge">
            <Icon
              name="code"
              class="size-3"
            />
            {language}
          </span>
        </div>
      )}
    </div>
  )
}
