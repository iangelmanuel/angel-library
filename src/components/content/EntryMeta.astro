---
import Icon from "@/components/shared/Icon.astro"
import CopyButton from "@/components/shared/CopyButton.astro"
import {
  CONTENT_TYPES,
  RESOURCE_CATEGORIES,
  type ResourceCategoryId
} from "@/config/site"
import { getEntryUrl, type AnyEntry } from "@/lib/content"
import { translateBlock } from "@/lib/pm-commands.mjs"

/** Metadatos propios del tipo, entre la cabecera y el markdown. */

interface Props {
  entry: AnyEntry
  entryMap: Map<string, AnyEntry>
}

const { entry, entryMap } = Astro.props
const data = entry.data as Record<string, unknown>

const techRefs = Array.isArray(data.technologies) ? data.technologies : []
const techEntries = techRefs
  .map((ref) => (typeof ref === "string" ? entryMap.get(ref) : undefined))
  .filter((item): item is AnyEntry => Boolean(item))

const warnings: string[] = Array.isArray(data.warnings)
  ? (data.warnings as string[])
  : []

const showWebsite = typeof data.website === "string"
const showGithub = typeof data.github === "string"

const showProblem =
  (entry.data.type === "recipes" ||
    entry.data.type === "patterns" ||
    entry.data.type === "tricks") &&
  typeof data.problem === "string"
const showCommand =
  entry.data.type === "commands" && typeof data.command === "string"
const showInstall =
  entry.data.type === "libraries" && typeof data.install === "string"
const installTabs = showInstall ? translateBlock(data.install as string) : null
const showResource =
  entry.data.type === "resources" && typeof data.url === "string"
const showTech = techEntries.length > 0
const showTool = entry.data.type === "skills" && typeof data.tool === "string"
const showLanguage =
  (entry.data.type === "snippets" ||
    entry.data.type === "hooks" ||
    entry.data.type === "utilities") &&
  typeof data.language === "string"

const hasMeta = [
  showWebsite,
  showGithub,
  showProblem,
  showCommand,
  showInstall,
  showResource,
  showTech,
  showTool,
  showLanguage
].some(Boolean)
---

{
  hasMeta && (
    <div class="mb-8 flex flex-col gap-4">
      {(showWebsite || showGithub) && (
        <div class="flex flex-wrap items-stretch gap-2">
          {showWebsite && (
            <a
              href={data.website as string}
              target="_blank"
              rel="noopener noreferrer"
              class="card mt-0 min-w-64 flex-1 flex-row items-center gap-3"
            >
              <span class="grid size-9 shrink-0 place-items-center border border-border bg-muted">
                <Icon
                  name="external-link"
                  class="size-4"
                />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate font-mono text-xs text-muted-foreground">
                  {data.website as string}
                </span>
                <span class="font-pixel text-[0.62rem] uppercase tracking-wider text-foreground">
                  documentación oficial
                </span>
              </span>
            </a>
          )}
          {showGithub && (
            <a
              href={data.github as string}
              target="_blank"
              rel="noopener noreferrer"
              class="badge shrink-0 self-start"
            >
              <Icon
                name="brand-github"
                class="size-3"
              />
              GitHub
            </a>
          )}
        </div>
      )}

      {showProblem && (
        <div class="callout mt-0">
          <span class="font-pixel text-[0.62rem] uppercase tracking-wider text-muted-foreground">
            Problema ·{" "}
          </span>
          {data.problem as string}
        </div>
      )}

      {showCommand && (
        <>
          <div class="code-block mt-0">
            <div class="code-block__header">
              <span class="code-block__label">terminal</span>
              <CopyButton label="Copiar comando" />
            </div>
            <pre class="command-line">
              <code>{data.command as string}</code>
            </pre>
          </div>

          {typeof data.whenToUse === "string" && (
            <p class="text-sm text-muted-foreground">
              <strong class="font-medium text-foreground">
                Cuándo usarlo:
              </strong>{" "}
              {data.whenToUse}
            </p>
          )}

          {warnings.length > 0 && (
            <div class="callout mt-0">
              <p class="mb-1.5 flex items-center gap-2 font-pixel text-[0.62rem] uppercase tracking-wider text-muted-foreground">
                <Icon
                  name="triangle-alert"
                  class="size-3.5"
                />{" "}
                Ojo
              </p>
              <ul class="flex flex-col gap-1">
                {warnings.map((warning) => (
                  <li>{warning}</li>
                ))}
              </ul>
            </div>
          )}
        </>
      )}

      {showInstall && installTabs && (
        <div class="code-block code-block--pm mt-0">
          <div class="code-block__header">
            <div
              class="code-block__pm-tabs"
              role="tablist"
            >
              <button
                type="button"
                class="code-block__pm-tab is-active"
                data-pm-tab="pnpm"
              >
                pnpm
              </button>
              <button
                type="button"
                class="code-block__pm-tab"
                data-pm-tab="bun"
              >
                bun
              </button>
              <button
                type="button"
                class="code-block__pm-tab"
                data-pm-tab="npm"
              >
                npm
              </button>
            </div>
            <CopyButton label="Copiar comando de instalación" />
          </div>
          <pre
            class="command-line"
            data-pm="pnpm"
          >
            <code>{installTabs.pnpm}</code>
          </pre>
          <pre
            class="command-line"
            data-pm="bun"
            hidden
          >
            <code>{installTabs.bun}</code>
          </pre>
          <pre
            class="command-line"
            data-pm="npm"
            hidden
          >
            <code>{installTabs.npm}</code>
          </pre>
        </div>
      )}

      {showInstall && !installTabs && (
        <div class="code-block mt-0">
          <div class="code-block__header">
            <span class="code-block__label">instalación</span>
            <CopyButton label="Copiar comando de instalación" />
          </div>
          <pre class="command-line">
            <code>{data.install as string}</code>
          </pre>
        </div>
      )}

      {showResource && (
        <a
          href={data.url as string}
          target="_blank"
          rel="noopener noreferrer"
          class="card mt-0 flex-row items-center gap-3"
        >
          <span class="grid size-9 shrink-0 place-items-center border border-border bg-muted">
            <Icon
              name="external-link"
              class="size-4"
            />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-mono text-xs text-muted-foreground">
              {data.url as string}
            </span>
            <span class="font-pixel text-[0.62rem] uppercase tracking-wider text-foreground">
              abrir recurso
            </span>
          </span>
          {typeof data.resourceCategory === "string" && (
            <span class="badge">
              {RESOURCE_CATEGORIES[data.resourceCategory as ResourceCategoryId]}
            </span>
          )}
        </a>
      )}

      {showTech && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-pixel text-[0.62rem] uppercase tracking-wider text-muted-foreground">
            {entry.data.type === "integrations" ? "Combina" : "Usa"}
          </span>
          {techEntries.map((tech) => (
            <a
              href={getEntryUrl(tech)}
              class="badge"
            >
              <Icon
                name={CONTENT_TYPES[tech.data.type].icon}
                class="size-3"
              />
              {tech.data.title}
            </a>
          ))}
        </div>
      )}

      {showTool && (
        <div>
          <span class="badge">
            <Icon
              name="bot"
              class="size-3"
            />
            {data.tool as string}
          </span>
        </div>
      )}

      {showLanguage && (
        <div>
          <span class="badge">
            <Icon
              name="code"
              class="size-3"
            />
            {data.language as string}
          </span>
        </div>
      )}
    </div>
  )
}
