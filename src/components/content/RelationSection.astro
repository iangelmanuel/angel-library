---
import ContentCard from '@/components/content/ContentCard.astro';
import Icon from '@/components/shared/Icon.astro';
import type { AnyEntry } from '@/lib/content';

interface Props {
  title: string;
  icon: string;
  entries: AnyEntry[];
}

const { title, icon, entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="mt-10">
      <h2 class="section-label mb-4 flex items-center gap-2">
        <Icon name={icon} class="size-3.5" />
        {title}
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {entries.map((entry) => (
          <ContentCard entry={entry} />
        ))}
      </div>
    </section>
  )
}
