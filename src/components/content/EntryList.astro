---
import { CONTENT_TYPES } from "@/config/content-types"
import { getEntryUrl, typeOf, type AnyEntry } from "@/lib/content"

interface Props {
  entries: AnyEntry[]
}

const { entries } = Astro.props
---

<ul class="entry-list not-content">
  {
    entries.map((entry) => (
      <li>
        <a href={getEntryUrl(entry)}>
          <span class="entry-list__type">
            {CONTENT_TYPES[typeOf(entry)].singular}
          </span>
          <span class="entry-list__title">{entry.data.title}</span>
          <span class="entry-list__description">{entry.data.description}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .entry-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .entry-list a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    border-radius: var(--radius-field);
    background: color-mix(in oklab, var(--blue-800) 16%, #000000);
    padding: 0.9rem 1rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-enamel);
  }

  .entry-list a:hover {
    background: color-mix(in oklab, var(--blue-800) 28%, #000000);
  }

  .entry-list__type {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-400);
  }

  .entry-list__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--white);
  }

  .entry-list__description {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--gray-400);
  }
</style>
