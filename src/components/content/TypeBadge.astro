---
import Icon from '@/components/shared/Icon.astro';
import { CONTENT_TYPES, type ContentTypeId } from '@/config/site';

interface Props {
  type: ContentTypeId;
  linked?: boolean;
}

const { type, linked = false } = Astro.props;
const meta = CONTENT_TYPES[type];
---

{
  linked ? (
    <a href={`/tipos/${type}`} class:list={['badge', `type-${type}`]}>
      <Icon name={meta.icon} class="size-3" />
      {meta.singular}
    </a>
  ) : (
    <span class:list={['badge', `type-${type}`]}>
      <Icon name={meta.icon} class="size-3" />
      {meta.singular}
    </span>
  )
}
