---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-x-3 gap-y-1.5">
      {tags.map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
          {tag}
        </a>
      ))}
    </div>
  )
}
