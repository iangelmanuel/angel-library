---
import Icon from "@/components/shared/Icon.astro"
import { CONTENT_TYPES } from "@/config/content-types"
import { getEntryUrl, type AnyEntry } from "@/lib/content"

interface Props {
  entry: AnyEntry
}

const { entry } = Astro.props
const meta = CONTENT_TYPES[entry.data.type]
const tags = entry.data.tags ?? []
---

<a
  href={getEntryUrl(entry)}
  class="card entry-card"
  style={`--card-accent: var(${meta.color})`}
>
  <div
    class="entry-card__bar"
    aria-hidden="true"
  >
    <span class="entry-card__path">{entry.id}</span>
  </div>
  <div class="entry-card__body">
    <div class="entry-card__meta">
      <span
        class:list={["flex items-center gap-1.5", `type-${entry.data.type}`]}
      >
        <Icon
          name={meta.icon}
          class="size-3.5"
        />
        <span>{meta.singular}</span>
      </span>
    </div>
    <h3>{entry.data.title}</h3>
    <p class="line-clamp-3">{entry.data.description}</p>
    {
      tags.length > 0 && (
        <div class="entry-card__tags">
          {tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
          {tags.length > 3 && (
            <span class="entry-card__more">+{tags.length - 3}</span>
          )}
        </div>
      )
    }
  </div>
</a>
