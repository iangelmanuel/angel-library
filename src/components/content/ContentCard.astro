---
import Icon from '@/components/shared/Icon.astro';
import { CONTENT_TYPES, type ContentTypeId } from '@/config/site';
import { getEntryUrl, type AnyEntry } from '@/lib/content';

interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const meta = CONTENT_TYPES[entry.collection as ContentTypeId];
const tags = entry.data.tags ?? [];
---

<a href={getEntryUrl(entry)} class:list={['card', `type-${entry.collection}`]}>
  <div class="flex items-center gap-1.5 text-muted-foreground">
    <Icon name={meta.icon} class="size-3" />
    <span class="font-pixel text-[0.6rem] uppercase tracking-wider">{meta.singular}</span>
  </div>
  <h3 class="text-[0.95rem] font-medium leading-snug text-foreground">
    {entry.data.title}
  </h3>
  <p class="line-clamp-2 text-[0.8rem] leading-relaxed text-muted-foreground">
    {entry.data.description}
  </p>
  {
    tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-1">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</a>
