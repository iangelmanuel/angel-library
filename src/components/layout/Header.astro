---
import Logo from "@/components/shared/Logo.astro"
import Icon from "@/components/shared/Icon.astro"
import { SITE } from "@/config/site"
---

<header
  class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-sm"
>
  <div class="mx-auto flex h-14 w-full max-w-[1440px] items-center gap-3 px-4">
    <button
      type="button"
      data-open-nav
      class="nav-link -ml-2 lg:hidden"
      aria-label="Abrir menú de navegación"
    >
      <Icon
        name="menu"
        size={16}
      />
    </button>

    <Logo />

    <div class="flex-1"></div>

    <a
      href={SITE.social.x}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 text-muted-foreground transition-colors hover:text-foreground hover:brightness-125"
      aria-label="Ver el perfil de X (Twitter)"
    >
      <Icon
        name="brand-x"
        size={16}
      />
    </a>

    <a
      href={SITE.social.github}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 text-muted-foreground transition-colors hover:text-foreground hover:brightness-125"
      aria-label="Ver repositorio en GitHub"
    >
      <Icon
        name="brand-github"
        size={16}
      />
    </a>

    <button
      type="button"
      data-open-search
      class="chrome-search hidden w-full max-w-xs sm:flex"
      aria-label="Abrir búsqueda (Control K)"
    >
      <Icon
        name="search"
        size={14}
      />
      <span class="flex-1 text-left">Buscar</span>
      <kbd class="kbd">ctrl K</kbd>
    </button>

    <button
      type="button"
      data-open-search
      class="nav-link sm:hidden"
      aria-label="Abrir búsqueda"
    >
      <Icon
        name="search"
        size={16}
      />
    </button>
  </div>
</header>
