---
import Icon from "@/components/shared/Icon.astro"
import { getEntryUrl, type AnyEntry } from "@/lib/content"

interface Props {
  prev?: AnyEntry
  next?: AnyEntry
}

const { prev, next } = Astro.props
---

{
  (prev || next) && (
    <nav
      class="mt-12 grid gap-3 border-t border-border pt-8 sm:grid-cols-2"
      aria-label="Navegación entre entradas"
    >
      {prev ? (
        <a
          href={getEntryUrl(prev)}
          class="card"
        >
          <span class="flex items-center gap-1.5 font-pixel text-[0.6rem] tracking-wider text-muted-foreground uppercase">
            <Icon
              name="arrow-left"
              class="size-3"
            />{" "}
            Anterior
          </span>
          <span class="text-sm font-medium text-foreground">
            {prev.data.title}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
      {next ? (
        <a
          href={getEntryUrl(next)}
          class="card items-end text-right"
        >
          <span class="flex items-center gap-1.5 font-pixel text-[0.6rem] tracking-wider text-muted-foreground uppercase">
            Siguiente{" "}
            <Icon
              name="arrow-right"
              class="size-3"
            />
          </span>
          <span class="text-sm font-medium text-foreground">
            {next.data.title}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
    </nav>
  )
}
