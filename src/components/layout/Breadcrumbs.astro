---
interface Crumb {
  label: string
  href?: string
  /** Nombre técnico del segmento en la ruta. */
  segment?: string
}

interface Props {
  items: Crumb[]
}

const { items } = Astro.props

const crumbs = items.filter(
  (item) => item.href !== "/" && item.label.toLowerCase() !== "inicio"
)
---

<nav
  aria-label="Ruta actual"
  class="breadcrumb mb-6"
>
  <span class="breadcrumb__path">
    <a
      href="/"
      aria-label="Ir al inicio"
      >Biblioteca</a
    >
    {
      crumbs.map((item) => (
        <>
          <span
            class="breadcrumb__separator"
            aria-hidden="true"
          >
            /
          </span>
          {item.href ? (
            <a
              href={item.href}
              aria-label={`Abrir ${item.label}`}
            >
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </>
      ))
    }
  </span>
</nav>
