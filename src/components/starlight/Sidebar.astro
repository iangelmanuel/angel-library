---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter"
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro"
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro"

const { sidebar } = Astro.locals.starlightRoute
---

<SidebarPersister>
  <ul class="top-level">
    {
      sidebar.map((entry) => (
        <li>
          {entry.type === "group" ? (
            <>
              <p class="nav-group-label">{entry.label}</p>
              <SidebarSublist
                sublist={entry.entries}
                nested
              />
            </>
          ) : (
            <a
              href={entry.href}
              aria-current={entry.isCurrent ? "page" : undefined}
              class="large"
              {...entry.attrs}
            >
              {entry.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  // Una sola categoría abierta a la vez: el atributo nativo `name` de
  // <details> ya hace el acordeón excluyente, sin JS de por medio. Solo
  // hace falta pegarlo, porque estos <details> los pinta SidebarSublist.
  function exclusiveCategories() {
    document
      .querySelectorAll<HTMLDetailsElement>(
        ".sidebar-content ul.top-level > li > ul > li > details"
      )
      .forEach((details) => {
        details.name = "sidebar-category"
      })
  }

  exclusiveCategories()
</script>

<style>
  @layer starlight.core {
    ul.top-level {
      list-style: none;
      padding: 0;
    }
    /* Un bloque respira del siguiente; adentro no hay más aire que el
       propio de las categorías. */
    ul.top-level > li + li {
      margin-top: 1.25rem;
    }
  }
</style>
