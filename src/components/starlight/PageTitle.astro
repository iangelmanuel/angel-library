---
import Default from "@astrojs/starlight/components/PageTitle.astro"
import Button from "@/components/shared/Button.astro"
import {
  CATEGORIES,
  RESOURCE_CATEGORIES,
  getSubcategory
} from "@/config/catalog"
import { CONTENT_TYPES, type ContentTypeId } from "@/config/content-types"
import { formatDate, getAllEntries } from "@/lib/content"

const { entry } = Astro.locals.starlightRoute
const data = entry.data as Record<string, unknown>

const [category, subcategory] = entry.id.split("/")
const categoryMeta = CATEGORIES[category]
const subcategoryMeta = getSubcategory(category, subcategory)
const typeMeta = data.type
  ? CONTENT_TYPES[data.type as ContentTypeId]
  : undefined

const tags = Array.isArray(data.tags) ? (data.tags as string[]) : []
const warnings = Array.isArray(data.warnings) ? (data.warnings as string[]) : []
const text = (field: string) =>
  typeof data[field] === "string" ? (data[field] as string) : null

// Tecnologías: de la ruta al título de la entrada.
const techRefs = Array.isArray(data.technologies)
  ? (data.technologies as string[])
  : []
const entries = techRefs.length > 0 ? await getAllEntries(true) : []
const technologies = techRefs
  .map((ref) => entries.find((item) => item.id === ref))
  .filter((item) => item !== undefined)

const isRepo = (href: string | null): href is string =>
  href !== null && /^https:\/\/(www\.)?github\.com\/.+/.test(href)

const website = text("website")
const url = text("url")

const repoHref = text("github") ?? [url, website].find(isRepo) ?? null
const resourceHref =
  [website, url].find(
    (href) => href !== null && href !== repoHref && !isRepo(href)
  ) ?? null

// El recurso lleva el botón primario; el repositorio, el secundario.
const links: {
  label: string
  href: string
  icon: string
  variant: "primary" | "secondary"
}[] = []
if (resourceHref) {
  links.push({
    label: "Abrir el recurso",
    href: resourceHref,
    icon: "external-link",
    variant: "primary"
  })
}
if (repoHref) {
  links.push({
    label: "Repositorio",
    href: repoHref,
    icon: isRepo(repoHref) ? "brand-github" : "external-link",
    variant: "secondary"
  })
}

const facts = [
  { label: "Problema", value: text("problem") },
  { label: "Cuándo usarlo", value: text("whenToUse") },
  { label: "Herramienta", value: text("tool") },
  { label: "Lenguaje", value: text("language") },
  { label: "Framework", value: text("framework") },
  { label: "Runtime", value: text("runtime") },
  { label: "Devuelve", value: text("returns") },
  {
    label: "Categoría de recurso",
    value: data.resourceCategory
      ? RESOURCE_CATEGORIES[String(data.resourceCategory)]
      : null
  }
].filter((fact): fact is { label: string; value: string } =>
  Boolean(fact.value)
)

const command = text("command")
const install = text("install")
const updatedAt = data.updatedAt instanceof Date ? data.updatedAt : null
---

<Default><slot /></Default>

<div class="entry-meta not-content">
  <div class="entry-meta__chips">
    {
      categoryMeta && (
        <a
          href={`/categories/${category}`}
          style={`--chip-accent: var(${categoryMeta.color})`}
        >
          {categoryMeta.label}
        </a>
      )
    }
    {
      subcategoryMeta?.badge && (
        <a href={`/categories/${category}#${subcategory}`}>
          {subcategoryMeta.label}
        </a>
      )
    }
    {typeMeta && <a href={`/tipos/${data.type}`}>{typeMeta.singular}</a>}
    {
      updatedAt && (
        <time
          class="entry-meta__date"
          datetime={updatedAt.toISOString()}
        >
          {formatDate(updatedAt)}
        </time>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <div class="entry-meta__tags">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`}>#{tag}</a>
        ))}
      </div>
    )
  }

  {
    (command || install) && (
      <pre class="entry-meta__command">{command ?? install}</pre>
    )
  }

  {
    technologies.length > 0 && (
      <div class="entry-meta__tags">
        {technologies.map((tech) => (
          <a href={`/${tech.id}`}>{tech.data.title}</a>
        ))}
      </div>
    )
  }

  {
    (facts.length > 0 || links.length > 0) && (
      <div class="entry-meta__row">
        {facts.length > 0 && (
          <dl class="entry-meta__facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {links.length > 0 && (
          <div class="entry-meta__links">
            {links.map((link) => (
              <Button
                href={link.href}
                variant={link.variant}
                icon={link.icon}
                iconPosition="start"
                external
              >
                {link.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    warnings.length > 0 && (
      <ul class="entry-meta__warnings">
        {warnings.map((warning) => (
          <li>{warning}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .entry-meta__chips,
  .entry-meta__tags,
  .entry-meta__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }

  .entry-meta__chips a {
    --chip-accent: var(--blue-400);
    border-radius: var(--radius-thin);
    background: color-mix(in oklab, var(--chip-accent) 14%, #000000);
    padding: 0.22rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--white);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-enamel);
  }

  .entry-meta__chips a:hover {
    background: color-mix(in oklab, var(--chip-accent) 24%, #000000);
  }

  .entry-meta__date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--gray-450);
  }

  .entry-meta__tags a {
    font-size: 0.75rem;
    color: var(--reading-link);
    text-decoration: none;
  }

  .entry-meta__tags a:hover {
    color: var(--white);
  }

  .entry-meta__command {
    margin: 0;
    border-radius: var(--radius);
    background: var(--code-bg);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--blue-200);
    overflow-x: auto;
  }

  /* Datos a la izquierda, acción a la derecha. */
  .entry-meta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  /* Sin datos a la izquierda el botón se quedaba pegado al margen: que sea
     él quien empuje, no el hueco de al lado. */
  .entry-meta__links {
    margin-inline-start: auto;
  }

  .entry-meta__facts {
    flex: 1 1 16rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.5rem;
    margin: 0;
  }

  .entry-meta__facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gray-450);
  }

  .entry-meta__facts dd {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--gray-300);
  }

  .entry-meta__warnings {
    margin: 0;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--destructive) 12%, #000000);
    padding: 0.6rem 0.8rem 0.6rem 1.8rem;
    font-size: 0.82rem;
    color: var(--gray-300);
  }
</style>
