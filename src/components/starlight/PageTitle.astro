---
import Default from "@astrojs/starlight/components/PageTitle.astro"
import Button from "@/components/shared/Button.astro"
import { CATEGORIES } from "@/config/categories"
import { formatDate, getAllEntries } from "@/lib/content"

const { entry } = Astro.locals.starlightRoute
const data = entry.data as Record<string, unknown>

const [category, subcategory] = entry.id.split("/")
const categoryMeta = CATEGORIES[category as keyof typeof CATEGORIES]
const subcategoryMeta = subcategory
  ? (
      categoryMeta?.subcategories as Record<
        string,
        { label: string; badge?: boolean }
      >
    )?.[subcategory]
  : undefined

const warnings = Array.isArray(data.warnings) ? (data.warnings as string[]) : []
const text = (field: string) =>
  typeof data[field] === "string" ? (data[field] as string) : null

// Tecnologías: de la ruta al título de la entrada.
const techRefs = Array.isArray(data.technologies)
  ? (data.technologies as string[])
  : []
const entries = techRefs.length > 0 ? await getAllEntries(true) : []
const technologies = techRefs
  .map((ref) => entries.find((item) => item.id === ref))
  .filter((item) => item !== undefined)

const isRepo = (href: string | null): href is string =>
  href !== null && /^https:\/\/(www\.)?github\.com\/.+/.test(href)

const website = text("website")
const url = text("url")

const repoHref = text("github") ?? [url, website].find(isRepo) ?? null
const resourceHref =
  [website, url].find(
    (href) => href !== null && href !== repoHref && !isRepo(href)
  ) ?? null

// El recurso lleva el botón primario; el repositorio, el secundario.
const links: {
  label: string
  href: string
  icon: string
  variant: "primary" | "secondary"
}[] = []
if (resourceHref) {
  links.push({
    label: "Abrir el recurso",
    href: resourceHref,
    icon: "external-link",
    variant: "primary"
  })
}
if (repoHref) {
  links.push({
    label: "Repositorio",
    href: repoHref,
    icon: isRepo(repoHref) ? "brand-github" : "external-link",
    variant: "secondary"
  })
}

const facts = [
  { label: "Problema", value: text("problem") },
  { label: "Cuándo usarlo", value: text("whenToUse") },
  { label: "Herramienta", value: text("tool") },
  { label: "Lenguaje", value: text("language") },
  { label: "Framework", value: text("framework") },
  { label: "Runtime", value: text("runtime") },
  { label: "Devuelve", value: text("returns") },
  {
    label: "Categoría de recurso",
    value: data.resourceCategory
      ? (
          CATEGORIES.resources.subcategories as Record<
            string,
            { label: string }
          >
        )[String(data.resourceCategory)]?.label
      : null
  }
].filter((fact): fact is { label: string; value: string } =>
  Boolean(fact.value)
)

const command = text("command")
const updatedAt = data.updatedAt instanceof Date ? data.updatedAt : null
---

<Default><slot /></Default>

<div class="entry-meta not-content">
  {
    (categoryMeta || updatedAt) && (
      <p
        class="entry-meta__path"
        style={
          categoryMeta ? `--chip-accent: var(${categoryMeta.color})` : undefined
        }
      >
        {categoryMeta && (
          <span class="entry-meta__category">{categoryMeta.label}</span>
        )}
        {subcategoryMeta && subcategoryMeta.badge !== false && (
          <>
            <span
              class="entry-meta__sep"
              aria-hidden="true"
            >
              /
            </span>
            <span class="entry-meta__subcategory">{subcategoryMeta.label}</span>
          </>
        )}
        {updatedAt && (
          <time
            class="entry-meta__date"
            datetime={updatedAt.toISOString()}
          >
            <span
              class="entry-meta__sep"
              aria-hidden="true"
            >
              ·
            </span>
            {formatDate(updatedAt)}
          </time>
        )}
      </p>
    )
  }

  {command && <pre class="entry-meta__command">{command}</pre>}

  {
    (facts.length > 0 || links.length > 0) && (
      <div class="entry-meta__panel">
        {facts.length > 0 && (
          <dl class="entry-meta__facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {links.length > 0 && (
          <div class="entry-meta__links">
            {links.map((link) => (
              <Button
                href={link.href}
                variant={link.variant}
                icon={link.icon}
                iconPosition="start"
                external
              >
                {link.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    technologies.length > 0 && (
      <div class="entry-meta__tech">
        <span class="entry-meta__tech-label">Relacionado</span>
        {technologies.map((tech) => (
          <a href={`/${tech.id}`}>{tech.data.title}</a>
        ))}
      </div>
    )
  }

  {
    warnings.length > 0 && (
      <ul class="entry-meta__warnings">
        {warnings.map((warning) => (
          <li>{warning}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.85rem;
  }

  /* La categoría es una ruta, no una ficha: "Frontend / Astro · 24 ago
     2026", en el color de la categoría — la misma idea que la carpeta que
     ya se ve en el sidebar, dicha en una línea. */
  .entry-meta__path {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.85rem;
  }

  .entry-meta__category {
    font-weight: 600;
    color: var(--chip-accent, var(--accent));
  }

  .entry-meta__subcategory {
    color: var(--text);
  }

  .entry-meta__sep {
    color: var(--line-strong);
  }

  .entry-meta__date {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .entry-meta__command {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-code);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--syn-green);
    overflow-x: auto;
  }

  /* Datos y acciones comparten un solo panel, sea cual sea la categoría:
     si la entrada trae algo de eso, aparece el panel; si no, no. */
  .entry-meta__panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    padding: 0.9rem 1.1rem;
  }

  .entry-meta__facts {
    flex: 1 1 16rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.6rem;
    margin: 0;
  }

  .entry-meta__facts dt {
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    color: var(--text-faint);
  }

  .entry-meta__facts dd {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--text);
  }

  .entry-meta__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* Tecnologías: entradas reales de la biblioteca, no tags — con su propio
     rótulo para no confundirse con lo que se acaba de quitar. */
  .entry-meta__tech {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: 0.78rem;
  }

  .entry-meta__tech-label {
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    color: var(--text-faint);
  }

  .entry-meta__tech a {
    color: var(--accent);
    text-decoration: none;
  }

  .entry-meta__tech a:hover {
    color: var(--text-strong);
  }

  .entry-meta__warnings {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklab, var(--syn-coral) 32%, var(--bg));
    background: color-mix(in oklab, var(--syn-coral) 8%, var(--bg));
    padding: 0.6rem 0.8rem 0.6rem 1.8rem;
    font-size: 0.82rem;
    color: var(--text);
  }
</style>
