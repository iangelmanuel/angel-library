---
import { Icon as AstroIcon } from "astro-icon/components"
import { RECOLORED_ICONS } from "@/config/icons"

interface Props {
  name: string
  size?: number
  class?: string
}

const { name, size = 16, class: className } = Astro.props

const recolored = RECOLORED_ICONS[name]
const isLocal = name.startsWith("brand-") && !recolored

const iconName = recolored
  ? `lucide:${recolored.base}`
  : isLocal
    ? name
    : `lucide:${name}`
---

<AstroIcon
  name={iconName}
  class={className}
  width={size}
  height={size}
  style={recolored ? `color: ${recolored.color}` : undefined}
  aria-hidden="true"
/>
