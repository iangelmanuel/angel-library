---
import { Icon as AstroIcon } from "astro-icon/components"
import { RECOLORED_ICONS } from "@/config/icons"

/** Icono del sitio, resuelto en build por astro-icon.
    - `brand-*` con archivo propio en `src/icons/` → se usa tal cual.
    - `brand-*` recoloreado → el icono de lucide con su color fijo.
    - cualquier otro nombre → la colección lucide.
    El tamaño va en píxeles y no depende de Tailwind: la documentación no
    carga utilidades y ahí `size-4` no existía. */

interface Props {
  name: string
  size?: number
  class?: string
}

const { name, size = 16, class: className } = Astro.props

const recolored = RECOLORED_ICONS[name]
const isLocal = name.startsWith("brand-") && !recolored

const iconName = recolored
  ? `lucide:${recolored.base}`
  : isLocal
    ? name
    : `lucide:${name}`
---

<AstroIcon
  name={iconName}
  class={className}
  width={size}
  height={size}
  style={recolored ? `color: ${recolored.color}` : undefined}
  aria-hidden="true"
/>
