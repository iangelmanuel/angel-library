---
import { getIcon } from '@/lib/icons';

/**
 * Icono Lucide inline, resuelto en build desde lucide-static.
 * Cero JavaScript en el cliente. El tamaño se controla con clases
 * (size-4, size-3.5…) y el color hereda de `currentColor`.
 *
 * Uso: <Icon name="search" class="size-4" />
 */

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<Fragment set:html={getIcon(name, className)} />
