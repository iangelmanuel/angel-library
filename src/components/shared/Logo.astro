---
import { Image } from "astro:assets"
import { SITE } from "@/config/site"
import logo from "@/assets/logo/angel-library-logo.webp"
---

<a
  href="/"
  class="logo-cycle group flex items-center gap-2.5"
  data-logo-cycle
  data-logo-color-index="-1"
  aria-label={`${SITE.name} — ir al inicio`}
>
  <Image
    src={logo}
    alt="Angel Library Logo"
    width={30}
    height={30}
    class="shrink-0 transition-transform group-hover:scale-105"
  />
  <span class="logo-cycle__text font-pixel text-sm tracking-wide"
    >{SITE.name}</span
  >
</a>
